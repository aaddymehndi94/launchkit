{
  "name": "@launchkit/infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "launchkit": "bin/launchkit.ts"
  },
  "scripts": {
    "synth": "cdk synth",
    "deploy:dev": "cross-env STAGE=dev cdk deploy LaunchKit-dev --require-approval never",
    "deploy:prod": "cross-env STAGE=prod cdk deploy LaunchKit-prod --require-approval broadening",
    "destroy:dev": "cross-env STAGE=dev cdk destroy LaunchKit-dev",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.253.1",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "aws-cdk": "^2.253.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.5",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
