{
  "name": "launchkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.13.1"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "pnpm -r --if-present --sort build",
    "typecheck": "pnpm -r --if-present --sort typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm -r --if-present --sort test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm db:check && pnpm cdk:synth",
    "docker:check": "tsx scripts/check-docker.ts",
    "db:local:up": "pnpm docker:check && docker compose -f docker-compose.local.yml up -d postgres",
    "db:local:down": "docker compose -f docker-compose.local.yml down",
    "db:local:reset": "tsx scripts/db-local-reset.ts",
    "db:check": "pnpm --filter @launchkit/db db:check",
    "db:generate": "pnpm --filter @launchkit/db db:generate",
    "db:ensure:local": "tsx scripts/ensure-local-db.ts",
    "db:ensure:dev": "pnpm --filter @launchkit/db db:ensure:dev",
    "db:ensure:prod": "pnpm --filter @launchkit/db db:ensure:prod",
    "db:status:local": "pnpm --filter @launchkit/db db:status:local",
    "db:status:dev": "pnpm --filter @launchkit/db db:status:dev",
    "db:status:prod": "pnpm --filter @launchkit/db db:status:prod",
    "db:migrate:local": "pnpm --filter @launchkit/db db:migrate:local",
    "db:migrate:dev": "pnpm --filter @launchkit/db db:migrate:dev",
    "db:migrate:prod": "tsx scripts/confirm-prod-migrate.ts",
    "db:seed:local": "pnpm --filter @launchkit/db db:seed:local",
    "cdk:synth": "pnpm --filter @launchkit/infra synth",
    "deploy:dev": "tsx scripts/deploy-stage.ts dev",
    "deploy:prod": "tsx scripts/deploy-stage.ts prod",
    "release:dev": "pnpm deploy:dev && pnpm smoke:dev",
    "release:prod": "pnpm deploy:prod && pnpm smoke:prod",
    "destroy:dev": "tsx scripts/confirm-destroy.ts dev",
    "destroy:prod": "tsx scripts/confirm-destroy.ts prod",
    "smoke:dev": "tsx scripts/smoke.ts dev",
    "smoke:prod": "tsx scripts/smoke.ts prod"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^24.0.10",
    "concurrently": "^9.2.0",
    "eslint": "^9.30.1",
    "globals": "^15.15.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.4"
  }
}
