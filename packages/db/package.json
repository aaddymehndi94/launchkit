{
  "name": "@launchkit/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "cross-env DATABASE_URL=postgres://launchkit:launchkit@localhost:5432/launchkit DATABASE_SSL=false tsx src/migrate.ts",
    "db:migrate:dev": "cross-env STAGE=dev tsx src/migrate.ts",
    "db:migrate:prod": "cross-env STAGE=prod tsx src/migrate.ts",
    "db:seed:local": "cross-env DATABASE_URL=postgres://launchkit:launchkit@localhost:5432/launchkit DATABASE_SSL=false tsx src/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.840.0",
    "@launchkit/contracts": "workspace:*",
    "@launchkit/core": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.4",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  }
}
