{
  "name": "@launchkit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./handler": "./src/handler.ts"
  },
  "scripts": {
    "dev": "tsx watch src/local-server.ts",
    "build": "tsc -p tsconfig.json --noEmit",
