    "@aws-sdk/s3-request-presigner": "^3.840.0",
    "@hono/node-server": "^1.14.4",
    "@launchkit/contracts": "workspace:*",
    "@launchkit/core": "workspace:*",
    "@launchkit/db": "workspace:*",
    "hono": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.150",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
