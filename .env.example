# Copy to .env.local for local development.
STAGE=local
AWS_REGION=us-east-1

# Local API and frontend
API_PORT=4000
WEB_PORT=5173
AUTH_MODE=local
VITE_AUTH_MODE=local
VITE_API_URL=http://localhost:4000

# Local Postgres from docker-compose.local.yml
DATABASE_URL=postgres://launchkit:launchkit@localhost:5432/launchkit
DATABASE_SSL=false

# Deployed stages read this JSON secret from AWS Secrets Manager:
# /launchkit/dev/app and /launchkit/prod/app
# {
#   "DATABASE_URL": "postgresql://...",
#   "DATABASE_SSL": "true"
# }
